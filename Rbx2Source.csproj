<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Rbx2Source</RootNamespace>
    <AssemblyName>RoPorter</AssemblyName>
    <ApplicationIcon>Resources\Images\Rbx2Source.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- One self-contained file per platform when published (dotnet publish -r win-x64 / linux-x64 / osx-arm64 ...). -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="App\*.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Export\*.cs" />
    <EmbeddedResource Include="Resources\Images\Rbx2Source.ico" LogicalName="RoPorter.favicon.ico" />
    <EmbeddedResource Include="Resources\Images\favicon.png" LogicalName="RoPorter.favicon.png" />
    <EmbeddedResource Include="Resources\Images\BrokenPreview.png" LogicalName="RoPorter.BrokenPreview.png" />
    <EmbeddedResource Include="Resources\Images\Humanoid_icon.png" LogicalName="RoPorter.Humanoid_icon.png" />
    <EmbeddedResource Include="Resources\Images\Accoutrement_icon.png" LogicalName="RoPorter.Accoutrement_icon.png" />
    <EmbeddedResource Include="Resources\Images\Player_icon.png" LogicalName="RoPorter.Player_icon.png" />
    <EmbeddedResource Include="Resources\Images\Model_icon.png" LogicalName="RoPorter.Model_icon.png" />
    <EmbeddedResource Include="Resources\Images\Configuration_icon.png" LogicalName="RoPorter.Configuration_icon.png" />
    <EmbeddedResource Include="Resources\Images\Starterpack_icon.png" LogicalName="RoPorter.Starterpack_icon.png" />
    <EmbeddedResource Include="Resources\Images\Workspace_icon.png" LogicalName="RoPorter.Workspace_icon.png" />
    <!-- Roblox's material textures, default sky and classic rbxasset:// textures (Export\RobloxContent.cs). -->
    <EmbeddedResource Include="Resources\Roblox\**\*" Exclude="Resources\Roblox\README.md" LogicalName="RoPorter.Roblox.%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- Images (textures, icons, previews); Avalonia draws with the same library. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- Encrypts the settings file for the Windows user (Linux and macOS use a key in the user's config folder). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Openize.Drako" Version="26.2.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
</Project>
